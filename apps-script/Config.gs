/** 스크립트 속성 읽기(필수) */
function prop_(key) {
  const v = PropertiesService.getScriptProperties().getProperty(key);
  if (!v) throw new Error(`설정값 '${key}'가 없습니다. 시트 메뉴 [🤖 컨택 자동화 → ⚙ 초기 설정]에서 입력하세요.`);
  return v;
}

/** 스크립트 속성 읽기(선택) */
function propOpt_(key) {
  return PropertiesService.getScriptProperties().getProperty(key) || '';
}
